        intervals [798]:
            xmin = 3239.602
            xmax = 3252.742
            text = "charley-mccoy: ᎾᎾ ᏕᎳᏆᏍᎬᏂ ᎨᎮᏍᏗ ᏅᎾᏁᏟᏗᏍᎬᏂ ᎨᎮᏍᏗ ᎤᏂᏬᏂᎯᏍᏗ ᎠᏂᏐ ᎲᏗ ᏱᎦᏰᎮᏍᏗ ᏣᎳᎩ ᎦᏬᏂᏓ ᏲᏁᎩᏛ ᏂᏓᎦᎵᏍᏛᏂ"
