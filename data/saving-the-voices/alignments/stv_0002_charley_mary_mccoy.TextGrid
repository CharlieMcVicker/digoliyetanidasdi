            text = "charley-mccoy: ᎤᎾ Ꮲ ᏳᎵᏑ ᎡᎵᏍᏓ ᎩᎶ ᏍᏊ maybe an hour or two ᏱᎢᏗᎦᏬᏂᏗ ᎠᏣᎳᎩ ᎬᏗ ᎡᎵᏍᏓ ᎤᏅᎨᏫᏍᏗ ᏂᎨᏒᏂ ᏙᏳ ᎮᏂ ᏫᏛᎵᏍᏆᏗᏟ ᎮᏂ ᏣᎳᎩ ᎢᎩᏬᏂᎯᏍᏗ"
