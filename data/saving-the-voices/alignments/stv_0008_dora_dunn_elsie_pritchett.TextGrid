            text = "mitch-holcomb: ᎥᏍᎩᎾ ᏄᏍᏛ ᎤᎾᏚᎵᏍᎬ ᏳᏅᏂᏗ ᎩᎳ ᎠᎾᏕᎶᏆᏍᎩ"
        intervals [1487]:
            xmin = 4283.969
            xmax = 4285.369
            text = ""
        intervals [1488]:
            xmin = 4285.369
            xmax = 4291.369
            text = "mitch-holcomb: ᎤᏠᏱᏭ ᏳᏍᏗ ᏲᏁᎦ ᎧᏁᏍᏗ ᎤᎾᏚᎸᏗ ᏄᏅᏂᏗ ᏣᎳᎩ"
        intervals [1489]:
            xmin = 4291.369
            xmax = 4292.929
            text = ""
        intervals [1490]:
            xmin = 4292.929
            xmax = 4294.289
            text = "mitch-holcomb: ᏴᏓᎭ ᎡᎵ Ᏹ Ᏹ"
        intervals [1491]:
            xmin = 4294.289
            xmax = 4295.090
            text = ""
        intervals [1492]:
            xmin = 4295.090
            xmax = 4295.830
            text = "elsie-pritchett: ᏱᏂᎦᎵᏍᏓ"
        intervals [1493]:
            xmin = 4295.830
            xmax = 4296.187
            text = ""
        intervals [1494]:
            xmin = 4296.187
            xmax = 4303.247
            text = "mitch-holcomb: ᏱᏂᎦᎵᏍᏓ ᎠᏎᏍᎩᏂ ᎤᎪᏛ ᎨᎲ ᎤᏮᏌ ᏫᎦᏙᎬ ᏣᎳᎩ ᎦᏬᏂᎯᏍᏗ"
        intervals [1495]:
            xmin = 4303.247
            xmax = 4304.107
            text = ""
        intervals [1496]:
            xmin = 4304.107
            xmax = 4307.767
            text = "mitch-holcomb: ᏴᏓᎭ ᎡᏍᎦ ᏄᎾᎵᏍᏓᏁᎲ how would you say this"
        intervals [1497]:
            xmin = 4307.767
            xmax = 4321.107
            text = "mitch-holcomb: A Cherokee don’t say that They might describe something like that like if they’re standing back looking ᏥᏲᎮᎲ ᎠᏎᏅ"
        intervals [1498]:
            xmin = 4321.107
            xmax = 4321.367
            text = ""
        intervals [1499]:
            xmin = 4321.367
            xmax = 4332.962
            text = "mitch-holcomb: ᎨᏍᏗ ᎥᏍᎩ ᏳᏍᏗ ᎧᏁᎬ ᎠᏣᎳᎩ ᏍᎩᎾ ᏳᎾᏕᎶᏆᎡᎸ ᏄᏍᏛ ᎤᏓᏅᏖᏗ ᎠᏣᎳᎩ ᎡᎵᏭ ᏯᎾᏕᎶᏆᎥᎦ"
        intervals [1500]:
