            text = "mitch-holcomb: ᎤᏠᏱᏭ ᏳᏍᏗ ᏲᏁᎦ ᎧᏁᏍᏗ ᎤᎾᏚᎸᏗ ᏄᏅᏂᏗ ᏣᎳᎩ"
        intervals [1487]:
            xmin = 4291.329
            xmax = 4292.909
            text = ""
        intervals [1488]:
            xmin = 4292.909
            xmax = 4294.269
            text = "mitch-holcomb: ᏴᏓᎭ ᎡᎵ Ᏹ Ᏹ"
        intervals [1489]:
            xmin = 4294.269
            xmax = 4295.270
            text = ""
        intervals [1490]:
            xmin = 4295.270
            xmax = 4296.010
            text = "elsie-pritchett: ᏱᏂᎦᎵᏍᏓ"
        intervals [1491]:
            xmin = 4296.010
            xmax = 4296.187
            text = ""
        intervals [1492]:
            xmin = 4296.187
            xmax = 4301.047
            text = "mitch-holcomb: ᏱᏂᎦᎵᏍᏓ ᎠᏎᏍᎩᏂ ᎤᎪᏛ ᎨᎲ ᎤᏮᏌ ᏫᎦᏙᎬ ᏣᎳᎩ ᎦᏬᏂᎯᏍᏗ"
        intervals [1493]:
            xmin = 4301.047
            xmax = 4304.107
            text = ""
        intervals [1494]:
            xmin = 4304.107
            xmax = 4307.707
            text = "mitch-holcomb: ᏴᏓᎭ ᎡᏍᎦ ᏄᎾᎵᏍᏓᏁᎲ how would you say this"
        intervals [1495]:
            xmin = 4307.707
            xmax = 4319.987
            text = "mitch-holcomb: A Cherokee don’t say that They might describe something like that like if they’re standing back looking ᏥᏲᎮᎲ"
        intervals [1496]:
            xmin = 4319.987
            xmax = 4320.387
            text = ""
        intervals [1497]:
            xmin = 4320.387
            xmax = 4332.927
            text = "mitch-holcomb: ᎠᏎᏅ ᎨᏍᏗ ᎥᏍᎩ ᏳᏍᏗ ᎧᏁᎬ ᎠᏣᎳᎩ ᏍᎩᎾ ᏳᎾᏕᎶᏆᎡᎸ ᏄᏍᏛ ᎤᏓᏅᏖᏗ ᎠᏣᎳᎩ ᎡᎵᏭ ᏯᎾᏕᎶᏆᎥᎦ"
        intervals [1498]:
