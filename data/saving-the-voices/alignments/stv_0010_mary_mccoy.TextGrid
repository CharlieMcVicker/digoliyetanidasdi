            text = "mary-mccoy: ᏝᏃ ᏯᏩᏅᏔ ᏝᏅᎮ ᎾᎥ ᎡᎯ ᏱᎨᎮ Ꮭ ᎩᎶ ᏳᎾᏛᎦᏁ ᏁᎲᎾ ᏫᏄᎵᏍᏔᏅ ᏛᏲᎱᏏᏟᎮᏃ ᏮᎦᎷᏨ ᏧᏪᏅᏒ ᎨᎪᎮᎴ"
        intervals [1065]:
            xmin = 4160.726
            xmax = 4161.606
            text = ""
        intervals [1066]:
            xmin = 4161.606
            xmax = 4165.166
            text = "mary-mccoy: ᏝᏃ ᏳᎾᏛᎦᏁᎢ ᎢᏅᎯᏅᎮ ᏂᏓᏳᏂᎩᏓ ᎠᎮ ᎨᎮ"
        intervals [1067]:
            xmin = 4165.166
            xmax = 4177.766
            text = "mary-mccoy: ᎾᎯᏳᏃ ᎣᏍᏓ ᎤᎴᏅᎲ ᎣᏍᏓ ᏂᎦᎵᏍᏗᎮ Ꮎ ᎤᏓᏂᎵ ᏍᎩᏃ Ꮎ ᎤᏩᏛᎰᎯᎮ Ꮎ ᎠᎪᎳᎾ ᎠᏥᎩᎵ"
        intervals [1068]:
            xmin = 4177.766
            xmax = 4178.607
            text = ""
        intervals [1069]:
            xmin = 4178.607
            xmax = 4187.127
            text = "charlie-shell: Ꮎ ᎠᎩᏍᏓᏴᎲᏍᎩ ᎤᏚᏥ ᏍᎩ ᏄᏛᏁᎴ ᏍᏊ ᎠᏥᏂᏴᎮᏃ ᏍᏊ"
        intervals [1070]:
            xmin = 4187.127
            xmax = 4188.667
            text = ""
        intervals [1071]:
            xmin = 4188.667
            xmax = 4198.307
            text = "charlie-shell: ᏍᎩ ᏌᎾᎴ ᎢᎪᎯᏓ ᎠᏥᏂᏴᎮ ᏌᎾᎴ ᏗᏜ ᏃᏭ ᎨᎲ ᏗᏍᎩᏲᎯ ᎠᏓᏙᎮᎮ ᏗᏍᎩᏲᎯ"
        intervals [1072]:
            xmin = 4198.307
            xmax = 4207.407
            text = "charlie-shell: ᏤᎩᎮᏃ ᏚᏙᎠ Ꮎ Ꮎ ᎤᏚᏓ ᏤᎩ ᏗᏍᎩᏲᎯ ᎠᏓᏙᎮᎮ Ᏺ ᏣᏥᏂᏴᏎ Ᏺ"
