            text = "charlie-shell: ᏳᏍᏗ ᎠᏓᏁᏟᏴᏍᎩ ᎠᏓᏁᏟᏴᏍᎬ ᎠᏎᏃ ᎠᏯᏃ ᏥᎦᏛᏗ ᎨᎲ"
