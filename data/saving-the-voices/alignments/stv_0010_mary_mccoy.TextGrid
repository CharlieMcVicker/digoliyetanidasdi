            text = "charlie-shell: ᎠᏓᏁᏟᏴᏍᎨ ᎪᎱᏍᏗ ᎦᎾᏰᎩ ᏢᏃ ᏢᏴ ᏥᎨᎲ ᎤᎦᏑᏘ ᎤᏔᎾ ᏥᏂᏴᏒ ᏣᏗᏍᎨ ᏍᎩ ᏳᏍᏗ ᎠᏓᏁᏟᏴᏍᎩ ᎠᏓᏁᏟᏴᏍᎬ ᎠᏎᏃ"
