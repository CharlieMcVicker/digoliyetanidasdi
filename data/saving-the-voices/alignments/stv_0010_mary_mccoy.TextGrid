        intervals [1074]:
            xmin = 4208.007
            xmax = 4216.967
            text = "charlie-shell: ᎠᏓᏁᏟᏴᏍᎨ ᎪᎱᏍᏗ ᎦᎾᏰᎩ ᏢᏃ ᏢᏴ ᏥᎨᎲ ᎤᎦᏑᏘ ᎤᏔᎾ ᏥᏂᏴᏒ ᏣᏗᏍᎨ ᏍᎩ"
        intervals [1075]:
            xmin = 4216.967
