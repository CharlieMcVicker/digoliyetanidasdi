        intervals [1683]:
            xmin = 4239.284
            xmax = 4239.444
            text = ""
        intervals [1684]:
            xmin = 4239.444
            xmax = 4244.844
            text = "dianna-guffey: ᏝᏍᎪ ᏱᏍᏓᏚᎵᎮ ᏍᏗᏆᏗᏍᏗ Ꮎ ᎪᎯ ᏥᏍᏗᏃᎮᎲ"
        intervals [1685]:
            xmin = 4244.844
            xmax = 4248.284
            text = "dianna-guffey: ᎭᏩ ᎣᏍᏓ ᎠᎩᏰᎸᎲ ᎠᏆᏛᏓᏍᏛ"
        intervals [1686]:
            xmin = 4248.284
            xmax = 4249.184
            text = ""
        intervals [1687]:
            xmin = 4249.184
            xmax = 4251.175
            text = "dianna-guffey: ᎭᏩ ᏃᏭ ᏗᏗᏍᏆᏗᎢ Billy"
        intervals [1688]:
            xmin = 4251.175
            xmax = 4251.248
            text = ""
        intervals [1689]:
            xmin = 4251.248
            xmax = 4252.768
            text = "billy-pettit: Alrighty well ᎦᎵᎡᎵᎦ"
        intervals [1690]:
            xmin = 4252.768
            xmax = 4253.444
            text = ""
        intervals [1691]:
            xmin = 4253.444
            xmax = 4254.104
            text = "dianna-guffey: ‘Ꮩ ᎮᎵ"
        intervals [1692]:
            xmin = 4254.104
            xmax = 4255.064
            text = ""
        intervals [1693]:
            xmin = 4255.064
            xmax = 4256.944
            text = "dianna-guffey: ᏓᎦᎵᏍᏔᏂᏟ ᏥᏗᏬᏂᎯ ᏣᎳᎩ"
        intervals [1694]:
            xmin = 4256.944
            xmax = 4257.300
            text = ""
        intervals [1695]:
            xmin = 4257.300
            xmax = 4262.540
            text = "billy-pettit: Well ᏲᎱᎡ ᏂᎦᏓ ᎯᎢ ᏗᏂᏲᏟ ᎦᏳᎾᏕ ᎠᏴ ᎮᎾᏲ ᏂᎦᏓ ᏱᏛᎾᏕᎶᏆᎢ"
        intervals [1696]:
            xmin = 4262.540
            xmax = 4263.080
            text = ""
        intervals [1697]:
            xmin = 4263.080
            xmax = 4267.380
            text = "billy-pettit: ᎠᏴ ᎠᏬᎯᏳᎯ ᎯᎢ ᏥᏓᏁᏲᎲᏍᎬ ᏣᏅᏔᎡ ᏥᏕᏓᏛᎯ"
        intervals [1698]:
            xmin = 4267.380
            xmax = 4268.060
            text = ""
        intervals [1699]:
            xmin = 4268.060
            xmax = 4274.940
            text = "billy-pettit: ᏧᎾᏕᎶᏆᏍᏗ ᏗᎦᏂᎩᏌ ᎠᏂᏲᏁᎦ ᏙᏧᎾᏛᏅ ᏃᏭ ᏱᏫᎩᎷᏣ ᏃᏭᎴ ᏣᎳᎩᎭ ᏥᎨᎲ"
        intervals [1700]:
            xmin = 4274.940
            xmax = 4275.520
            text = ""
        intervals [1701]:
            xmin = 4275.520
            xmax = 4283.740
            text = "billy-pettit: ᎠᏴᏲ ᎨᎵᎰ ᎯᎢ ᏥᏓᏁᏲᎲᏍᎬ ᎥᏍᎩᎡ ᎦᎷᎶᎦ ᏃᏭ ᏥᏓᏁᏲᎲᏍᎬ ᏱᏭᎵᏍᏆᏓ"
        intervals [1702]:
            xmin = 4283.740
            xmax = 4284.440
            text = ""
        intervals [1703]:
            xmin = 4284.440
            xmax = 4286.900
            text = "billy-pettit: ᏳᎾᏂᎩᏌ ᏃᏭᏅ ᏂᎦᏓ ᏲᏁᎩᎭ and"
        intervals [1704]:
            xmin = 4286.900
            xmax = 4288.893
            text = ""
        intervals [1705]:
            xmin = 4288.893
            xmax = 4289.893
            text = "dianna-guffey: ᏍᎩᎾ ᎠᏲᏍᏗ ᏙᎲ"
        intervals [1706]:
            xmin = 4289.893
            xmax = 4289.913
            text = ""
        intervals [1707]:
            xmin = 4289.913
            xmax = 4294.013
            text = "billy-pettit: ᏍᎩᎾ ᎠᏲᏍᏗ ᎾᏅ ᏥᏄᏍᏛ Daver Dave Pettie ᎢᎦ Ꮎ"
        intervals [1708]:
            xmin = 4294.013
            xmax = 4296.033
            text = ""
        intervals [1709]:
            xmin = 4296.033
            xmax = 4299.553
            text = "billy-pettit: he got mixed up English and in Cherokee ‘Ꮩ ᏴᏓ Ꮎ"
        intervals [1710]:
            xmin = 4299.553
            xmax = 4302.262
            text = ""
        intervals [1711]:
            xmin = 4302.262
            xmax = 4303.742
            text = "billy-pettit: ᎤᏍᏆᎸᏛ stutter ᏥᏄᎵᏍᏓᏁᎲ"
        intervals [1712]:
            xmin = 4303.742
            xmax = 4311.902
            text = "billy-pettit: that that was why He couldn’t comprehend it English and in Cherokee ᎤᏲᏢᏭ ᏥᏂᎦᏪᎲ"
