        intervals [1688]:
            xmin = 4262.660
            xmax = 4263.060
            text = ""
        intervals [1689]:
            xmin = 4263.060
            xmax = 4267.360
            text = "billy-pettit: ᎠᏴ ᎠᏬᎯᏳᎯ ᎯᎢ ᏥᏓᏁᏲᎲᏍᎬ ᏣᏅᏔᎡ ᏥᏕᏓᏛᎯ"
        intervals [1690]:
            xmin = 4267.360
            xmax = 4268.040
            text = ""
        intervals [1691]:
            xmin = 4268.040
            xmax = 4271.660
            text = "billy-pettit: ᏧᎾᏕᎶᏆᏍᏗ ᏗᎦᏂᎩᏌ ᎠᏂᏲᏁᎦ ᏙᏧᎾᏛᏅ"
        intervals [1692]:
            xmin = 4271.660
            xmax = 4272.140
            text = ""
        intervals [1693]:
            xmin = 4272.140
            xmax = 4283.720
            text = "billy-pettit: ᏃᏭ ᏱᏫᎩᎷᏣ ᏃᏭᎴ ᏣᎳᎩᎭ ᏥᎨᎲ ᎠᏴᏲ ᎨᎵᎰ ᎯᎢ ᏥᏓᏁᏲᎲᏍᎬ ᎥᏍᎩᎡ ᎦᎷᎶᎦ ᏃᏭ ᏥᏓᏁᏲᎲᏍᎬ ᏱᏭᎵᏍᏆᏓ"
        intervals [1694]:
            xmin = 4283.720
            xmax = 4284.440
            text = ""
        intervals [1695]:
            xmin = 4284.440
            xmax = 4286.900
            text = "billy-pettit: ᏳᎾᏂᎩᏌ ᏃᏭᏅ ᏂᎦᏓ ᏲᏁᎩᎭ and"
        intervals [1696]:
            xmin = 4286.900
            xmax = 4288.893
            text = ""
        intervals [1697]:
            xmin = 4288.893
            xmax = 4289.893
            text = "dianna-guffey: ᏍᎩᎾ ᎠᏲᏍᏗ ᏙᎲ"
        intervals [1698]:
            xmin = 4289.893
            xmax = 4289.913
            text = ""
        intervals [1699]:
            xmin = 4289.913
            xmax = 4293.993
            text = "billy-pettit: ᏍᎩᎾ ᎠᏲᏍᏗ ᎾᏅ ᏥᏄᏍᏛ Daver Dave Pettie ᎢᎦ Ꮎ"
        intervals [1700]:
            xmin = 4293.993
            xmax = 4296.013
            text = ""
        intervals [1701]:
            xmin = 4296.013
            xmax = 4299.533
            text = "billy-pettit: he got mixed up English and in Cherokee ‘Ꮩ ᏴᏓ Ꮎ"
        intervals [1702]:
            xmin = 4299.533
            xmax = 4302.262
            text = ""
        intervals [1703]:
            xmin = 4302.262
            xmax = 4303.722
            text = "billy-pettit: ᎤᏍᏆᎸᏛ stutter ᏥᏄᎵᏍᏓᏁᎲ"
        intervals [1704]:
            xmin = 4303.722
            xmax = 4311.882
            text = "billy-pettit: that that was why He couldn’t comprehend it English and in Cherokee ᎤᏲᏢᏭ ᏥᏂᎦᏪᎲ"
