        intervals [1684]:
            xmin = 4573.900
            xmax = 4579.140
            text = "randy-duncan: Yeah Ꮭ ᏳᎾᏅᏖᏍᏗ ᏳᏍᏗ ᏌᎷᏱ ᎪᎱᏍᏗ"
        intervals [1685]:
            xmin = 4579.140
            xmax = 4585.880
            text = "randy-duncan: Ꭳ ᎣᎢ ᎣᎢᏰᎢᏍᏛ Ꮻ ᏫᏗᎩᏍᎬ ᏕᎦᏁᎶᏅ ᎠᎹᏳᎵᏗ"
        intervals [1686]:
            xmin = 4585.880
            xmax = 4598.180
            text = "randy-duncan: ᏍᎩᏭ ᏃᏭ Ꮭ ᏳᎾᏅᏖᏍᏗ ᏍᎩᎾᎾ ‘ᎠᎮᎾ ᏏᎡᏲ ᎠᏣᎳᎩ ᎠᏂᏬᏂᏍᎨᏍᏗ ᏍᎩᎾ ᏓᎩᏍᏕᎸᎲ ᏓᎩᏲᎱᏎᎵ ᎮᎾ"
