        intervals [1682]:
            xmin = 4568.555
            xmax = 4573.600
            text = "charlie-shell: ᎠᏬᎯᏳᏛ ᎠᏂᏬᏂᏍᎨᏍᏗ Ꮭ ᏍᎩᎾᏲ ᎠᏴ ᏥᏂᏬᏂᎯ ᏳᏍᏗ ᏯᏂᏬᏂᏍᎨᏍᏗ"
