        intervals [1680]:
            xmin = 4564.467
            xmax = 4566.267
            text = "randy-duncan: ‘Ꭱ ᏂᎯᎾ ᎮᎵ ᎤᏠᏱ"
        intervals [1681]:
            xmin = 4566.267
