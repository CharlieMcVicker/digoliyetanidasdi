            text = "mack-flynn: Ꮭ Ꮭ ᏭᏟ ᏱᎪᎯᏓ ᏱᏛᏟᎢᎵᏙᎵ ᎦᏳᎳ ᏃᏭ ᎮᎾ ᏥᎩ this generation ᏃᏭ ᏥᎩ ᏔᎵᏚ ᏦᎠᏚ ᏧᎾᏕᏘᏴᏓ ᏗᏂᏲᏟ Ꮭ ᎮᎾ even some in their 20’s ᏧᎾᏕᏘᏴᏓ Ꮭ Ꮭ ᏣᎳᎩ ᏯᏂᏬᏂᎯ"
