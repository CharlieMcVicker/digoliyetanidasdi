            xmin = 3372.589
            xmax = 3379.829
            text = "michael-pritchett: ᎠᏎᏅ Ꮎ ᏙᎩᎶᏫᏍᏓᏁ ᏍᎩᏅ ᏍᏆᏂᏛ ᎬᏬᎮᎰ ᏝᏲ ᏥᏍᏆᏂ ᏥᎦᏥᏲᎮᎸᏛ ᏍᎩᏂ"
