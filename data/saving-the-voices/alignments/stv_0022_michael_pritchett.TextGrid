            text = "michael-pritchett: Ꮩ ᎮᎾ ᎤᏚᎵᏗ ᎮᎾ ᏂᎦᏛᎾ ᎪᎯ ᏥᎩ ᏍᎩᎾ ᏣᎳᎩ ᎠᏂᏬᏂᏍᎩ ᏍᎩ ᎢᎦ ᎾᏭ ᎠᏁ"
        intervals [1436]:
            xmin = 3334.949
            xmax = 3335.929
            text = ""
        intervals [1437]:
            xmin = 3335.929
            xmax = 3343.809
            text = "michael-pritchett: ᎪᎯᏅ ᏍᏊ Ꮎ ᏲᏁᎦ ᎮᎾ ᏳᎾᏚᎵᎰ ᎤᏂᏬᎯᏍᏗ ᎤᎪᏙᏗ ᎪᎯ ᏥᎩ ᏏᏅ Ꮎ huh"
        intervals [1438]:
            xmin = 3343.809
            xmax = 3345.189
            text = ""
        intervals [1439]:
            xmin = 3345.189
            xmax = 3351.689
            text = "michael-pritchett: ᏥᏂᎦᎵᏍᏗ ᏥᏄᎵᏍᏛ ᎪᎯᏗ ᏥᎨᎲ Ꮭ ᎢᎸᎯᏳ ᏲᏁᎦ ᎢᏗᏬᏂᎲ ᏍᎩᎾ ᎢᎦᏓᏠᎬ ᎨᎲ"
        intervals [1440]:
            xmin = 3351.689
            xmax = 3352.109
            text = ""
        intervals [1441]:
            xmin = 3352.109
            xmax = 3360.649
            text = "michael-pritchett: ᎪᎯᏅ ᏥᎩ ᏍᎩᏛ ᏳᎾᏚᎵᎰ ᏲᏁᎦ ᎠᏍᏆᏂ ᎠᎴ ᏱᎩ ᎤᎾᏚᎵᎰ ᏧᎾᏕᏲᏗ ᎾᎾ ᎠᏯ ᏗᎦᏛᏒ"
        intervals [1442]:
            xmin = 3360.649
            xmax = 3361.609
            text = ""
        intervals [1443]:
            xmin = 3361.609
            xmax = 3369.149
            text = "michael-pritchett: ᏥᏗᏬᏂ Ꮭ ᎾᏭ ᎩᎶ ᎤᏚᎵᎰ ᎤᏬᏂᎲᏍᏗ ᏥᎦᏥᏲᎮᎲᏛ ᏝᏲ ᏯᏩᏚᎵᎰ ᎠᏂᏍᏆᏂ"
        intervals [1444]:
            xmin = 3369.149
            xmax = 3369.689
            text = ""
        intervals [1445]:
            xmin = 3369.689
            xmax = 3379.849
            text = "michael-pritchett: ᏣᏂᏬᏂ ᎠᏩᏕᎳᎰ ᎠᏎᏅ Ꮎ ᏙᎩᎶᏫᏍᏓᏁ ᏍᎩᏅ ᏍᏆᏂᏛ ᎬᏬᎮᎰ ᏝᏲ ᏥᏍᏆᏂ ᏥᎦᏥᏲᎮᎸᏛ ᏍᎩᏂ Ꮎ"
        intervals [1446]:
            xmin = 3379.849
            xmax = 3380.849
            text = ""
        intervals [1447]:
            xmin = 3380.849
            xmax = 3393.609
            text = "michael-pritchett: ᏌᏊ ᎠᏧᏣ ᎭᎵᏍᎪᏨᏛ ᎠᏍᏆᏁ ᎠᏬᎮᎲᏛ alright ᎾᎾ ᏧᎦᏍᏗ ᎯᎵᏃᎮᏗ ᎾᎾ ᏂᎯ ᏣᏬᏂᎯᏍᏗ ᎠᏬᎮᎲᏛ ᏙᏅ"
        intervals [1448]:
            xmin = 3393.609
            xmax = 3395.029
            text = ""
        intervals [1449]:
            xmin = 3395.029
            xmax = 3403.309
            text = "michael-pritchett: ᏥᏲᎮᎸ ᏙᎲᏲ ᏕᎯᎦᎷᏨ ᎤᎷᎶᏨ ᎯᏍᏆᏂ ᏥᏲᎮᎸ ᏓᏩᎧᎾᏅ ᏝᏲ ᎠᏍᏆᏂ ᏱᎦᏗ"
        intervals [1450]:
            xmin = 3403.309
            xmax = 3407.001
            text = ""
        intervals [1451]:
            xmin = 3407.001
            xmax = 3408.161
            text = "michael-cooksey: ᎣᏣᎵᎮᎵᎩ"
        intervals [1452]:
            xmin = 3408.161
            xmax = 3408.707
            text = ""
        intervals [1453]:
            xmin = 3408.707
            xmax = 3420.827
            text = "michael-pritchett: ᎠᏯᏛ ᏍᏊ ᎦᎵᎮᎵᎦ ᏓᎦᎬᏢᏃᎮᏗ ᏥᎩ cause boy ᎠᏩᏚᎵᏛ ᎠᏬᎮᎲ Cora ᏚᎾᏚᎵᎰ ᎮᎾ ᎠᏂᏣᎳᎩ ᎠᏂᏬᏂᎯᏍᏗ ᏍᏗᏅ ᎾᏭ"
        intervals [1454]:
            xmin = 3420.827
            xmax = 3421.847
            text = ""
        intervals [1455]:
            xmin = 3421.847
            xmax = 3431.747
            text = "michael-pritchett: ᎦᏓᏅᏖᏍᎬ boy ᏙᎲᏲ ᏯᏩᏢᏃᎵᏗ ᏍᎩ ᎠᏩᏛᎾᏗ ᎨᎵᎰ ᎾᏭ ᎪᎯ ᏥᎩ ᎠᏎᏅ ᎠᎩᏃᏎᎸ ᏚᏯ ᏪᏙᎸᎢ ᎦᎯᎵᏃᎮᏔᏅ ᎠᏬᎮᎸᏛ"
