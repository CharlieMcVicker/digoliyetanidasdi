            text = "michael-pritchett: ᏥᏗᏬᏂ Ꮭ ᎾᏭ ᎩᎶ ᎤᏚᎵᎰ ᎤᏬᏂᎲᏍᏗ ᏥᎦᏥᏲᎮᎲᏛ ᏝᏲ ᏯᏩᏚᎵᎰ ᎠᏂᏍᏆᏂ ᏣᏂᏬᏂ ᎠᏩᏕᎳᎰ"
