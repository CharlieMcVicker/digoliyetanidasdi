        intervals [1165]:
            xmin = 3867.617
            xmax = 3880.537
            text = "jerry-scott: ᎭᏩᏭ ᎣᏏᏛ ᎩᎶ ᏳᎵᏍᏕᎵᏙᏗᏔᎾ ᏳᏍᏗ ᏥᎩᏃᎮᏢ ᏗᎾᏛᏍᎩ ᏥᎩ ᏯᎾᏓᏅᏛᎳ ᎢᎦ y’know"
        intervals [1166]:
            xmin = 3880.537
            xmax = 3887.177
            text = "jerry-scott: Ꮭ ᏙᏳ ᏂᎦᎵᏍᏗᎲᏭ ᏱᎾᏓᏛᎦ"
        intervals [1167]:
