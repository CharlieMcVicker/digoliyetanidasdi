        intervals [1170]:
            xmin = 3901.777
            xmax = 3908.437
            text = "jerry-scott: ᏛᎾᎵᏒᏂ ᏍᏊ ᎠᏗ ᏗᏂᏓᏂᏱᏍᎩ ᏍᏊ ᎨᏍᏗ ᏰᎮᏍᏗ ᏗᎧᎾᏩᏛᏍᏗ ᎠᏗᎮᎾ"
