        intervals [1168]:
            xmin = 3889.277
            xmax = 3899.977
            text = "jerry-scott: ᎾᎮᎾ ᏍᏊ Ꮭ ᏯᏩᏅᏔ ᏤᎵᏒ ᏱᎩ ᏗᏂᏓᏂᏱᏍᎩ ᏥᎩ ᎾᎡ ᏍᏊ rough ᏥᏓᏅᏁᎲ ᏴᏫ ᎠᏎᏍᎩᏂ"
