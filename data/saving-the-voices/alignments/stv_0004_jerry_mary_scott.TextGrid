        intervals [1161]:
            xmin = 3867.617
            xmax = 3880.537
            text = "jerry-scott: ᎭᏩᏭ ᎣᏏᏛ ᎩᎶ ᏳᎵᏍᏕᎵᏙᏗᏔᎾ ᏳᏍᏗ ᏥᎩᏃᎮᏢ ᏗᎾᏛᏍᎩ ᏥᎩ ᏯᎾᏓᏅᏛᎳ ᎢᎦ y’know"
        intervals [1162]:
            xmin = 3880.537
            xmax = 3893.517
            text = "jerry-scott: Ꮭ ᏙᏳ ᏂᎦᎵᏍᏗᎲᏭ ᏱᎾᏓᏛᎦ ᎾᎮᎾ ᏍᏊ Ꮭ ᏯᏩᏅᏔ ᏤᎵᏒ ᏱᎩ"
