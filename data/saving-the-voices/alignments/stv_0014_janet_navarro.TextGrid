            xmax = 3541.365
            text = "charlie-shell: ‘ᎸᏍᎩ ᏄᎲᎡ ᏧᏪᏙᎸ ᎠᎨᏯ ᎣᏥᏍᏆᏗᏍᏗᎮ Boy ᎠᏩᏚᎵᎲ ‘ᏥᎩᎵ ᏕᏥᎪᎥ Ꮫ ᎢᏨᏃᏎᏗ ᎤᏛᏅ ᎦᏳᎳ ᎣᎩᏍᏆᏛ ᎨᎲ ᎠᏎᏃ ᎯᏲᎵᎦᏅ ᏍᏊ Jenny Fletcher"
