            xmax = 3496.771
            text = "charlie-shell: ᏓᏬᎮᎸ ᏍᏗᏃ ᎠᏩᏓᎾᏛᎸ ᏳᏍᏗ Yeah ᏩᏩᏓᏛᏁ"
