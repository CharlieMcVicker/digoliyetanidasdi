            text = ""
        intervals [997]:
            xmin = 3474.911
            xmax = 3485.931
            text = "charlie-shell: ᎤᎪᎵᏰᎥᏅ ᎮᏍᏗᏅ ᏍᏊ ᏗᎦᏚᎸᎮ ᎤᏛᏁᎡ ᎥᎾᏭ ᎤᎾ ᎤᎾ ᎤᎾ ᎦᏳᎳ ᎤᎾᏛᏁᎵᏙᎸ ᏧᏂ ᏧᏂᎸᏫᏍᏓᏁᎯ"
