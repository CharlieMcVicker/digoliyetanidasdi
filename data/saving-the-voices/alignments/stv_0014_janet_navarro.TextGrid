            text = "charlie-shell: Ᏺ ᏦᎩᏂᎷᏤᎸ ᎤᏩᏌ ᏦᎩᏂᏃᏎᎴ ᏥᏈᏍᏗ ᎮᏅ ᎫᏍᏗ ᎬᏛᏅᏍᎬ Ꮭ ᏳᏓᎭ Ꮭ ᏯᏩᎾᏙ ᏂᎦᏛᏁᎰ ᏥᏯᏘᏂᏙᎰ ᎤᏍᏗ ᏧᏛᏅ ᏙᏳ ᏥᏬ"
        intervals [982]:
            xmin = 3401.592
            xmax = 3403.592
            text = ""
        intervals [983]:
            xmin = 3403.592
            xmax = 3416.432
            text = "charlie-shell: Ꮷ ᏗᏁᎲ ᏥᏬᎩᏁᏙᎸ ᎦᎵᏦᏕ Ꮭ ᎫᏍᏗᏭ ᎫᏍᏗ ᎠᎵᏍᏓᏴᏗ ᏳᏂᎮ ᎠᎪᎾ ᏄᎾᏛᏁᏕᎨ ᏍᎩᎾ ᏫᏍᏓᏘᏁᏒᎢ ᏥᎧᏃᎮᎴ ᏙᏳᏅ Ꮟ"
        intervals [984]:
            xmin = 3416.432
            xmax = 3416.652
            text = ""
        intervals [985]:
            xmin = 3416.652
            xmax = 3429.012
            text = "charlie-shell: ᎠᏯ Ꮭ ᎦᏳᎳ ᎣᏍᏓ ᎤᏩᏌ ᎮᏅ ᏚᏓᏘᎾᎥ ᏍᏊ ᎨᎲ ᏃᏊᎴ ᏐᎢ ᎠᏧᏣ ᎤᏠᏱ Mary LouᏍ ᎯᏲᎵᎦ"
        intervals [986]:
            xmin = 3429.012
            xmax = 3429.692
            text = ""
        intervals [987]:
            xmin = 3429.692
            xmax = 3435.312
            text = "charlie-shell: ᎥᎩᏙ ᏃᏊᎴ ᎤᎵᏏ ᎤᏍᏗᏭ ᏥᎨᎲ ᏦᎩᏂᎧᏁᎴ ᏍᎩᎾ"
        intervals [988]:
            xmin = 3435.312
            xmax = 3436.352
            text = ""
        intervals [989]:
            xmin = 3436.352
            xmax = 3449.552
            text = "charlie-shell: and and ᏃᏊᎴ ᎯᎠ ᎯᎠ ᏦᎢ ᎾᏕᏘᏯ ᏥᎨᎲ ᏃᏊᎴ ᏔᎵ ᏙᏍᏗ ᏂᎦᏓᏅ ᏥᏕᏂ ᏥᏕᏥᏃᎮ ᏍᎩᎾ ᏧᎾᏓᎦᏴᎵᎨ ᎫᏍᏗ ᎠᎾᏛᏅᏍᎬ ᏂᎦᎵᏍᏙᏗᏍᎨ Ꮩ ᏙᎩᏂᎧᏁᎲ"
        intervals [990]:
