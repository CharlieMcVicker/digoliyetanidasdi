            xmax = 3473.951
            text = "charlie-shell: visitation ᎣᏍᏗ ᎣᏍᏓ ᏚᎪᎵᏰᎥ Ꮎ ᎠᏍᎦᏯ ᎤᏩᎧᎲ ᎯᎠ ᎣᏂ"
