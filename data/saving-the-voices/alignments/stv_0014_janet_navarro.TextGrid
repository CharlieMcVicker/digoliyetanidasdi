            text = ""
        intervals [991]:
            xmin = 3450.200
            xmax = 3450.760
            text = "janet-navarro: ᎤᏲᎡ"
        intervals [992]:
            xmin = 3450.760
            xmax = 3454.451
            text = ""
        intervals [993]:
            xmin = 3454.451
            xmax = 3467.491
            text = "charlie-shell: ᎤᏲᎡ ᏄᎵᏍᏓᏁᏛᎪᏂ ᏛᏴᏛᏁᎵ ᎮᏅ ᎨᎵ Ꮎ ᎮᏅ DHS ᏃᏭ Ꮧ ᏦᏍᏗᎪᏛᏗᏭ ᎣᏍᏓᎵᏒᎯᎲ uh"
