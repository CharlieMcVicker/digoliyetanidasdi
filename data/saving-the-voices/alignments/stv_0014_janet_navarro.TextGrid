        intervals [1002]:
            xmin = 3499.173
            xmax = 3514.293
            text = "charlie-shell: ᎾᎯᏳ ᏒᎯᏰ ᏙᏍᏓᎾᏫᏛᎲ ᎾᎡ ᏙᎩᎾᏝᏫᏍᏛ adopted ᏙᏍᏛᏁᎴ ᎠᏎᏍᎩᏂ ᏂᎦᎵᏍᏙᏗ ᎤᏲ ᎠᏂᎪᏩᏛᎯᏙᎲ ᏙᏍᏗᏯᏅᎲ ᎮᏅ"
