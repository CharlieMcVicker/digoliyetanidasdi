        intervals [999]:
            xmin = 3486.611
            xmax = 3491.871
            text = "charlie-shell: ᏃᏭᏅ ᎤᏂᏴᏟᎦ ᎠᏂᏐᏃ Uh Mr Shell do you want ‘em"
