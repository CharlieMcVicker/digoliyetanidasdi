        intervals [995]:
            xmin = 3468.331
            xmax = 3473.891
            text = "charlie-shell: visitation ᎣᏍᏗ ᎣᏍᏓ ᏚᎪᎵᏰᎥ Ꮎ ᎠᏍᎦᏯ ᎤᏩᎧᎲ ᎯᎠ ᎣᏂ"
        intervals [996]:
            xmin = 3473.891
